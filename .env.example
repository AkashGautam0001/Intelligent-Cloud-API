# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/intelligent-cloud

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@intelligent-cloud.com
ADMIN_PASSWORD=Admin@12345

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# File uploads (local filesystem)
UPLOAD_DIR=uploads

# SMTP (client mail server). Leave SMTP_HOST empty in local/dev to log instead of send.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Intelligent-Cloud <noreply@intelligent-cloud.com>
# Comma-separated team notify list for contact / booking / ticket alerts
NOTIFY_EMAILS=abu.fahad@intelligent-cloud.com,fahad@intelligent-cloud.com,fareed@intelligent-cloud.com,riyadh@intelligent-cloud.com
